{
  "name": "node-package-notifier",
  "productName": "NPN",
  "version": "2.1.0",
  "description": "A simple Electron Js app that notify new npm package release.",
  "type": "module",
  "main": ".vite/build/index.js",
  "scripts": {
    "start": "cross-env ENVIRONMENT=DEV electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "format": "prettier --parser typescript --write *.ts src/**/*.ts src/**/*.tsx",
    "check:format": "prettier --parser typescript --list-different *.ts src/**/*.ts src/**/*.tsx",
    "check:types": "tsc --skipLibCheck --noEmit",
    "check:lint": "eslint --config=eslint.config.js",
    "test:renderer": "vitest --config=vite.renderer.config.ts --watch=false"
  },
  "keywords": [],
  "author": "Thibault Picard",
  "license": "GPL-3.0",
  "devDependencies": {
    "@electron-forge/cli": "7.8.1",
    "@electron-forge/maker-appx": "7.8.1",
    "@electron-forge/maker-deb": "7.8.1",
    "@electron-forge/maker-rpm": "7.8.1",
    "@electron-forge/maker-squirrel": "7.8.1",
    "@electron-forge/maker-wix": "7.8.1",
    "@electron-forge/maker-zip": "7.8.1",
    "@electron-forge/plugin-fuses": "7.8.1",
    "@electron-forge/plugin-vite": "7.8.1",
    "@electron/fuses": "1.8.0",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/node": "22.15.17",
    "@types/opener": "1.4.3",
    "@types/react": "19.1.4",
    "@types/react-dom": "19.1.4",
    "@types/semver": "7.7.0",
    "cross-env": "7.0.3",
    "electron": "36.2.0",
    "eslint": "9.26.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.1.0",
    "prettier": "3.5.3",
    "sass": "1.88.0",
    "ts-node": "10.9.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.32.1",
    "vite": "6.3.5",
    "vitest": "3.1.3"
  },
  "dependencies": {
    "@ant-design/v5-patch-for-react-19": "1.0.3",
    "antd": "5.25.1",
    "cache-manager": "6.4.3",
    "cron": "4.3.0",
    "effector": "23.3.0",
    "effector-react": "23.3.0",
    "electron-log": "5.4.0",
    "electron-squirrel-startup": "1.0.1",
    "electron-store": "10.0.1",
    "i18next": "25.1.2",
    "mime": "4.0.7",
    "opener": "1.5.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "15.5.1",
    "react-router": "7.6.0",
    "semver": "7.7.2"
  }
}
