{
  "name": "node-package-notifier",
  "productName": "NPN",
  "version": "2.1.1",
  "description": "A simple Electron Js app that notify new npm package release.",
  "type": "module",
  "main": ".vite/build/index.js",
  "scripts": {
    "start": "cross-env ENVIRONMENT=DEV electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "format": "prettier --parser typescript --write *.ts src/**/*.ts src/**/*.tsx",
    "check:format": "prettier --parser typescript --list-different *.ts src/**/*.ts src/**/*.tsx",
    "check:types": "tsc --skipLibCheck --noEmit",
    "check:lint": "eslint --config=eslint.config.js",
    "test:renderer": "vitest --config=vite.renderer.config.ts --watch=false"
  },
  "keywords": [],
  "author": "Thibault Picard",
  "license": "GPL-3.0",
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-appx": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-wix": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron/fuses": "2.1.3",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/node": "24.13.2",
    "@types/opener": "1.4.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/semver": "7.7.1",
    "cross-env": "10.1.0",
    "electron": "43.0.0",
    "eslint": "9.39.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "prettier": "3.9.4",
    "sass": "1.101.0",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vite": "7.3.2",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "antd": "6.5.0",
    "cache-manager": "7.2.9",
    "cron": "4.4.0",
    "effector": "23.4.4",
    "effector-react": "23.3.0",
    "electron-log": "5.4.4",
    "electron-squirrel-startup": "1.0.1",
    "electron-store": "11.0.2",
    "i18next": "26.3.4",
    "mime": "4.1.0",
    "opener": "1.5.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-i18next": "17.0.8",
    "react-router": "8.1.0",
    "semver": "7.8.5"
  }
}
